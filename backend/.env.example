# Copy this file to .env and fill in your OWN values.
# Never commit .env — it's already in .gitignore.

# Get a free key at https://console.groq.com/keys
GROQ_API_KEY=your_key_here

# The frontend origin(s) allowed to call this API (CORS). Comma-separate
# multiple origins if needed, e.g. for both local dev and a deployed URL:
#   ALLOWED_ORIGIN=http://localhost:5173,https://your-app.awsapprunner.com
# In the single-container production setup, frontend and backend are served
# from the same origin, so this mostly matters for local dev (Vite on 5173
# calling the backend on 8000).
ALLOWED_ORIGIN=http://localhost:5173

# JWT signing secret — generate your own, e.g. `openssl rand -hex 32`
SECRET_KEY=random_string
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# SQLite by default; swap for Postgres etc. later if needed
DATABASE_URL=sqlite:///./elevatr.db
